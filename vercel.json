{
  "redirects": [
    {
      "source": "/t",
      "destination": "https://exp.daydreamers.app/?utm_source=tiktok&utm_medium=social",
      "permanent": false
    },
    {
      "source": "/i",
      "destination": "https://exp.daydreamers.app/?utm_source=instagram&utm_medium=social",
      "permanent": false
    },
    {
      "source": "/liz",
      "destination": "https://apps.apple.com/app/apple-store/id6763168108?pt=128232174&ct=liz&mt=8",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(audio|screenshots)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(logo.svg|logo.png|favicon.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
